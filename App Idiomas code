            document.getElementById("perfilDetalle").style.display = "flex";
        }

        function seleccionarIdioma(boton) {
            let botones = document.querySelectorAll(".idioma");
            botones.forEach(function(b) {
                b.classList.remove("seleccionado");
            });
            boton.classList.add("seleccionado");
        }

        function seleccionarNivel(boton) {
            let botones = document.querySelectorAll(".nivel");
            botones.forEach(function(b) {
                b.classList.remove("seleccionado");
            });
            boton.classList.add("seleccionado");
        }

        function seleccionarTiempo(boton) {
            let botones = document.querySelectorAll(".tiempo");
            botones.forEach(function(b) {
                b.classList.remove("seleccionado");
            });
            boton.classList.add("seleccionado");
        }

        function seleccionarOpcionEjercicio(boton) {
            let opciones = document.querySelectorAll(".opcion-btn");
            opciones.forEach(function(o) {
                o.classList.remove("correcta");
                o.querySelectorAll(".check-icon").forEach(e => e.remove());
            });
            boton.classList.add("correcta");
            
            const checkL = document.createElement("span");
            checkL.className = "check-icon check-left";
            checkL.textContent = "✓";
            
            const checkR = document.createElement("span");
            checkR.className = "check-icon check-right";
            checkR.textContent = "✓";

            boton.prepend(checkL);
            boton.appendChild(checkR);
        }
    </script>

