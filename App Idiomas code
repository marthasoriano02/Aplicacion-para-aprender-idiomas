<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SpeakEasy</title>

    <!-- Fuente moderna Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Poppins', Arial, sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background: #d9c0e5;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px 0;
        }

        /* ================================= */
        /* PANTALLAS (TAMAÑO MÓVIL) */
        /* ================================= */

        .pantalla {
            width: 400px;
            height: 700px;
            background: #E6C7ED;
            border-radius: 28px;
            text-align: center;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            align-items: center;
            box-shadow: 0 12px 30px rgba(123, 21, 153, 0.2);
            position: relative;
        }

        /* ================================= */
        /* BOTONES GENERALES */
        /* ================================= */

        button {
            border: none;
            cursor: pointer;
            border-radius: 15px;
            transition: all 0.2s ease;
            outline: none;
        }

        button:hover {
            opacity: 0.95;
            transform: translateY(-2px);
        }

        button:active {
            transform: translateY(0);
        }

        .comenzar, .siguiente {
            width: 220px;
            height: 52px;
            background: #9291C9;
            color: white;
            font-size: 20px;
            font-weight: 700;
            box-shadow: 0 4px 12px rgba(146, 145, 201, 0.35);
        }

        /* ================================= */
        /* EFECTO DIFUMINADO EN PERSONAJES  */
        /* ================================= */

        .img-difuminada {
            -webkit-mask-image: radial-gradient(circle, rgba(0,0,0,1) 55%, rgba(0,0,0,0) 100%);
            mask-image: radial-gradient(circle, rgba(0,0,0,1) 55%, rgba(0,0,0,0) 100%);
            filter: drop-shadow(0px 6px 12px rgba(123, 21, 153, 0.25));
        }

        /* ================================= */
        /* PRIMERA PANTALLA - INICIO BIENVENIDA */
        /* ================================= */

        #inicio {
            padding-top: 25px;
            justify-content: space-between;
            padding-bottom: 35px;
        }

        #inicio img {
            width: 270px;
            height: 270px;
            object-fit: contain;
        }

        #inicio h1 {
            color: #7B1599;
            font-size: 32px;
            font-weight: 700;
            margin-top: 5px;
        }

        #inicio p {
            color: #7B1599;
            font-size: 23px;
            line-height: 1.25;
            font-weight: 600;
            margin: 10px 0;
        }

        /* ================================= */
        /* NUEVA PANTALLA - INICIO PRINCIPAL / DASHBOARD */
        /* ================================= */

        #inicioPrincipal {
            display: none;
            background: #1e1233;
            color: white;
            padding: 0;
            justify-content: space-between;
        }

        .contenedor-dashboard {
            width: 100%;
            padding: 25px 20px 10px 20px;
            display: flex;
            flex-direction: column;
            gap: 14px;
            overflow-y: auto;
            flex: 1;
            text-align: left;
        }

        .saludo-usuario {
            text-align: center;
            font-size: 20px;
            font-weight: 700;
            margin-top: 5px;
            color: #ffffff;
        }

        .avatar-contenedor {
            display: flex;
            justify-content: center;
            margin: 5px 0;
        }

        .avatar-img {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            background: #E6C7ED;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 36px;
            border: 2px solid #a88beb;
        }

        .card-dash {
            background: #2b1c48;
            border-radius: 18px;
            padding: 14px 16px;
            position: relative;
            cursor: pointer;
            transition: transform 0.2s;
        }

        .card-dash:hover {
            transform: translateY(-2px);
        }

        .card-meta-header {
            display: flex;
            justify-content: space-between;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 8px;
            color: #e0d0f5;
        }

        .barra-meta-bg {
            width: 100%;
            height: 8px;
            background: #3c2960;
            border-radius: 10px;
            overflow: hidden;
        }

        .barra-meta-fill {
            width: 35%;
            height: 100%;
            background: #a855f7;
            border-radius: 10px;
        }

        .card-con-icono {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .card-info-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .icon-dash {
            font-size: 22px;
        }

        .card-titulos h4 {
            font-size: 14px;
            font-weight: 700;
            color: #ffffff;
        }

        .card-titulos p {
            font-size: 12px;
            color: #b3a2ce;
            margin-top: 2px;
        }

        .arrow-dash {
            color: #b3a2ce;
            font-size: 14px;
            font-weight: bold;
        }

        .grid-doble {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .card-stat {
            background: #2b1c48;
            border-radius: 18px;
            padding: 14px;
            display: flex;
            flex-direction: column;
            gap: 6px;
            cursor: pointer;
        }

        .stat-header {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 12px;
            font-weight: 600;
            color: #ffffff;
        }

        .stat-num {
            font-size: 20px;
            font-weight: 700;
            margin-top: 4px;
        }

        .grafico-racha {
            display: flex;
            align-items: flex-end;
            gap: 4px;
            height: 30px;
            margin-top: 4px;
        }

        .col-racha {
            flex: 1;
            background: #6b46a1;
            border-radius: 4px;
        }

        .col-racha.activa {
            background: #a855f7;
        }

        .seccion-explorar {
            font-size: 14px;
            font-weight: 700;
            margin-top: 5px;
            color: #ffffff;
        }

        .carrusel-lecciones {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
            padding-bottom: 5px;
        }

        .card-mini-leccion {
            height: 65px;
            border-radius: 14px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 4px;
            cursor: pointer;
            transition: transform 0.2s ease;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
        }

        .card-mini-leccion:hover {
            transform: translateY(-2px);
        }

        .card-mini-leccion span.icon {
            font-size: 18px;
        }

        .card-mini-leccion span.label {
            font-size: 11px;
            font-weight: 700;
            color: #1e1233;
            text-align: center;
        }

        /* ================================= */
        /* SEGUNDA PANTALLA - IDIOMAS */
        /* ================================= */

        #idiomas {
            display: none;
            padding-top: 60px;
            width: 100%;
            justify-content: space-between;
            padding-bottom: 35px;
        }

        .titulo {
            background: #9291C9;
            color: white;
            padding: 10px 24px;
            border-radius: 15px;
            font-size: 20px;
            font-weight: 600;
            margin-bottom: 25px;
            display: inline-block;
            box-shadow: 0 4px 10px rgba(146, 145, 201, 0.25);
        }

        .contenedor-idiomas {
            display: flex;
            flex-direction: column;
            align-items: center;
            width: 100%;
        }

        .idioma {
            width: 170px;
            height: 40px;
            background: #9291C9;
            color: white;
            font-size: 19px;
            font-weight: 500;
            margin-bottom: 14px;
        }

        .idioma.seleccionado {
            background: #7B1599;
            box-shadow: 0 4px 12px rgba(123, 21, 153, 0.35);
        }

        .globo {
            font-size: 130px;
            line-height: 1;
            margin: 5px 0;
            filter: drop-shadow(0 8px 16px rgba(0,0,0,0.15));
        }

        /* ================================= */
        /* TERCERA PANTALLA - SOBRE TI */
        /* ================================= */

        #sobreMi {
            display: none;
            background: white;
            position: relative;
            justify-content: flex-start;
        }

        .parte-superior {
            width: 100%;
            height: 205px;
            background: #E6C7ED;
            position: relative;
            padding-top: 35px;
            text-align: left;
        }

        .titulo-sobre-mi {
            color: #7B1599;
            font-size: 26px;
            font-weight: 700;
            line-height: 1.2;
            width: 190px;
            margin-left: 20px;
            text-align: center;
        }

        .subtitulo {
            color: #8C7B8D;
            font-size: 14px;
            font-weight: 500;
            line-height: 1.3;
            width: 185px;
            margin-left: 20px;
            margin-top: 10px;
            text-align: center;
        }

        .personaje2 {
            position: absolute;
            width: 165px;
            height: 190px;
            object-fit: contain;
            right: 0px;
            bottom: 0px;
        }

        .contenido {
            width: 100%;
            height: 495px;
            background: white;
            border-radius: 25px 25px 0 0;
            padding: 26px 18px;
            text-align: left;
            box-shadow: 0 -5px 15px rgba(0, 0, 0, 0.04);
        }

        .pregunta {
            color: #222222;
            font-size: 15px;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .nombre {
            width: 100%;
            height: 42px;
            border: none;
            border-radius: 20px;
            background: #EFEFEF;
            padding: 0 18px;
            font-size: 14px;
            outline: none;
            margin-bottom: 20px;
            color: #222;
            transition: all 0.2s;
        }

        .nombre:focus {
            box-shadow: 0 0 0 2px #9291C9;
            background: #ffffff;
        }

        .niveles {
            display: flex;
            gap: 8px;
            margin-bottom: 24px;
        }

        .nivel {
            flex: 1;
            height: 46px;
            background: #EFEFEF;
            color: #333;
            font-size: 12px;
            font-weight: 600;
            border-radius: 12px;
        }

        .nivel.seleccionado {
            background: #9291C9;
            color: white;
            box-shadow: 0 3px 8px rgba(146, 145, 201, 0.35);
        }

        .tiempos {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
            margin-top: 10px;
        }

        .tiempo {
            width: 190px;
            height: 36px;
            background: #EFEFEF;
            color: #333;
            font-size: 13px;
            font-weight: 600;
            border-radius: 18px;
        }

        .tiempo.seleccionado {
            background: #9291C9;
            color: white;
            box-shadow: 0 3px 8px rgba(146, 145, 201, 0.35);
        }

        .btn-finalizar {
            width: 100%;
            height: 48px;
            background: #7B1599;
            color: white;
            font-size: 16px;
            font-weight: 700;
            border-radius: 15px;
            margin-top: 25px;
            box-shadow: 0 4px 12px rgba(123, 21, 153, 0.3);
        }

        /* ================================= */
        /* CUARTA PANTALLA - LECCIONES / UNIDAD */
        /* ================================= */

        #unidad {
            display: none;
            background: #F4E8F8;
            padding: 0;
            justify-content: space-between;
        }

        .header-unidades {
            width: 100%;
            padding: 20px 20px 10px 20px;
        }

        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .btn-back {
            color: #7B1599;
            font-size: 24px;
            font-weight: 700;
            cursor: pointer;
            padding: 0 5px;
        }

        .titulo-nivel {
            color: #7B1599;
            font-size: 20px;
            font-weight: 700;
        }

        .points-badge {
            background: #7B1599;
            color: white;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .info-unidad {
            text-align: left;
            margin-top: 10px;
        }

        .titulo-unidad {
            color: #7B1599;
            font-size: 16px;
            font-weight: 700;
        }

        .progreso-header {
            display: flex;
            justify-content: space-between;
            color: #8C7B8D;
            font-size: 12px;
            font-weight: 600;
            margin-top: 12px;
            margin-bottom: 6px;
        }

        .barra-progreso-bg {
            width: 100%;
            height: 8px;
            background: #E2D0E7;
            border-radius: 10px;
            overflow: hidden;
        }

        .barra-progreso-fill {
            width: 25%;
            height: 100%;
            background: #7B1599;
            border-radius: 10px;
        }

        .contenedor-lecciones {
            width: 100%;
            padding: 0 16px;
            display: flex;
            flex-direction: column;
            gap: 12px;
            overflow-y: auto;
            flex: 1;
        }

        .card-leccion {
            background: white;
            border-radius: 20px;
            padding: 14px 18px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.03);
            text-align: left;
            cursor: pointer;
            transition: transform 0.2s;
        }

        .card-leccion:hover {
            transform: scale(1.01);
        }

        .leccion-left {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .icon-leccion {
            font-size: 32px;
            width: 40px;
            display: flex;
            justify-content: center;
        }

        .detalles-leccion h4 {
            color: #222;
            font-size: 15px;
            font-weight: 700;
        }

        .detalles-leccion p {
            font-size: 12px;
            font-weight: 500;
            margin-top: 2px;
        }

        .estado-completada { color: #8C7B8D; }
        .estado-progreso { color: #7B1599; }
        .estado-bloqueada { color: #A393A6; }

        .status-icon {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
        }

        .icon-check {
            background: #4CAF50;
            color: white;
        }

        .icon-arrow {
            background: #EFEFEF;
            color: #7B1599;
            font-weight: bold;
        }

        .icon-lock {
            color: #A393A6;
            font-size: 18px;
        }

        /* NAVEGACIÓN INFERIOR COMPARTIDA */
        .bottom-nav {
            width: 100%;
            height: 65px;
            background: white;
            display: flex;
            justify-content: space-around;
            align-items: center;
            border-top: 1px solid #EAEAEA;
            padding: 0 5px;
        }

        .nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 3px;
            color: #A393A6;
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
            flex: 1;
        }

        .nav-item.activo {
            color: #7B1599;
        }

        .nav-item-icon {
            font-size: 18px;
        }

        /* ================================= */
        /* QUINTA PANTALLA - DETALLE DE LECCIÓN */
        /* ================================= */

        #leccionDetalle {
            display: none;
            background: white;
            padding: 0;
            justify-content: space-between;
        }

        .header-leccion {
            width: 100%;
            background: #E6C7ED;
            padding: 15px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .titulo-leccion-header {
            text-align: center;
        }

        .titulo-leccion-header h3 {
            color: #7B1599;
            font-size: 18px;
            font-weight: 700;
        }

        .titulo-leccion-header p {
            color: #333;
            font-size: 13px;
            font-weight: 600;
        }

        .progress-indicator {
            text-align: right;
            font-size: 12px;
            font-weight: 700;
            color: #7B1599;
        }

        .mini-progress-bar {
            width: 40px;
            height: 8px;
            background: #7B1599;
            border-radius: 10px;
            margin-top: 4px;
        }

        .contenido-leccion {
            width: 100%;
            padding: 18px;
            flex: 1;
            display: flex;
            flex-direction: column;
            text-align: left;
            overflow-y: auto;
        }

        .seccion-titulo {
            font-size: 13px;
            font-weight: 700;
            color: #333;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .bloque-interactivo {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
        }

        .frases-escucha {
            display: flex;
            flex-direction: column;
            gap: 10px;
            flex: 1;
        }

        .card-frase {
            background: #F4E8F8;
            padding: 10px 16px;
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .card-frase span {
            font-weight: 700;
            color: #222;
            font-size: 15px;
        }

        .btn-audio {
            background: #E6C7ED;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #7B1599;
            font-size: 16px;
        }

        .personaje-leccion {
            width: 130px;
            height: 140px;
            object-fit: contain;
        }

        .lista-palabras {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .item-palabra {
            background: #FAF8FB;
            padding: 10px 14px;
            border-radius: 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .palabra-en {
            font-weight: 700;
            font-size: 13px;
            color: #222;
        }

        .palabra-es {
            font-size: 12px;
            color: #8C7B8D;
            font-weight: 500;
        }

        .footer-leccion {
            width: 100%;
            padding: 15px 20px;
            background: white;
        }

        .btn-continuar-leccion {
            width: 100%;
            height: 48px;
            background: #7B1599;
            color: white;
            font-size: 16px;
            font-weight: 700;
            border-radius: 18px;
            box-shadow: 0 4px 12px rgba(123, 21, 153, 0.3);
        }

        /* ================================= */
        /* SEXTA PANTALLA - EJERCICIOS */
        /* ================================= */

        #ejercicioDetalle {
            display: none;
            background: white;
            padding: 0;
            justify-content: space-between;
        }

        .header-ejercicio {
            width: 100%;
            background: #E6C7ED;
            padding: 15px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .titulo-ejercicio-header {
            text-align: center;
        }

        .titulo-ejercicio-header h3 {
            color: #7B1599;
            font-size: 18px;
            font-weight: 700;
        }

        .contenido-ejercicio {
            width: 100%;
            padding: 24px 20px;
            flex: 1;
            display: flex;
            flex-direction: column;
            text-align: left;
        }

        .instruccion-ejercicio {
            font-size: 13px;
            font-weight: 600;
            color: #333;
            margin-bottom: 25px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .card-pregunta {
            background: #FAF8FB;
            border: 1px solid #EAEAEA;
            border-radius: 20px;
            padding: 18px;
            text-align: center;
            font-size: 20px;
            font-weight: 700;
            color: #222;
            margin-bottom: 25px;
        }

        .opciones-ejercicio {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .opcion-btn {
            width: 100%;
            padding: 14px 18px;
            border-radius: 20px;
            border: 1px solid #EAEAEA;
            background: #FAF8FB;
            color: #333;
            font-size: 14px;
            font-weight: 600;
            text-align: center;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            cursor: pointer;
            transition: all 0.2s;
        }

        .opcion-btn.correcta {
            background: #F4E8F8;
            border-color: #D3A7DE;
            color: #222;
            font-weight: 700;
        }

        .opcion-btn .check-icon {
            position: absolute;
            width: 22px;
            height: 22px;
            background: #7B1599;
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            font-weight: bold;
        }

        .check-left { left: 15px; }
        .check-right { right: 15px; }

        .footer-ejercicio {
            width: 100%;
            padding: 15px 20px 25px 20px;
            background: white;
        }

        .btn-comprobar {
            width: 100%;
            height: 50px;
            background: #7B1599;
            color: white;
            font-size: 17px;
            font-weight: 700;
            border-radius: 22px;
            box-shadow: 0 4px 12px rgba(123, 21, 153, 0.3);
        }

        /* ================================= */
        /* SÉPTIMA PANTALLA - TRADUCTOR */
        /* ================================= */

        #traductorDetalle {
            display: none;
            background: #F9F5FB;
            padding: 0;
            justify-content: space-between;
        }

        .header-traductor {
            width: 100%;
            background: #E6C7ED;
            padding: 15px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .titulo-traductor-header h3 {
            color: #7B1599;
            font-size: 18px;
            font-weight: 700;
        }

        .contenido-traductor {
            width: 100%;
